APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://confidia:confidia_secret@localhost:5432/confidia
REDIS_URL=redis://localhost:6379/0

KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=confidia
KEYCLOAK_CLIENT_ID=confidia-backend
KEYCLOAK_CLIENT_SECRET=confidia-backend-secret

PAPERLESS_URL=http://localhost:8001
PAPERLESS_TOKEN=  # Générer via: curl -X POST http://localhost:8001/api/token/ -H "Content-Type: application/json" -d '{"username":"admin","password":"admin"}'

NEXTCLOUD_URL=http://localhost:8081
NEXTCLOUD_USER=admin
NEXTCLOUD_PASSWORD=admin

CORS_ORIGINS=http://localhost:3000,http://localhost:8082
